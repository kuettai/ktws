{
  "mcpServers": {
    "rst-local": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "mcp-server",
        "python",
        "server.py"
      ],
      "env": {
        "AWS_PROFILE": "workshop",
        "AWS_REGION": "us-east-1",
        "REDSHIFT_WORKGROUP": "rst-workshop",
        "REDSHIFT_DATABASE": "dev",
        "OPS_API_BASE_URL": "http://localhost:8080",
        "OPS_API_KEY": "local-dev-key",
        "PROMO_API_BASE_URL": "http://localhost:8081",
        "PROMO_API_TOKEN": "legacy-dev-token",
        "LOCAL_ROLE": "hq"
      },
      "disabled": false,
      "autoApprove": []
    },
    "rst-local-http": {
      "url": "http://localhost:8000/mcp",
      "disabled": true
    },
    "rst-remote-ecs": {
      "url": "<McpUrl>",
      "oauth": {
        "clientId": "<kiro-user client id>",
        "redirectUri": "http://localhost:7778/oauth/callback",
        "oauthScopes": [
          "openid",
          "<McpUrl>/read"
        ]
      },
      "disabled": true,
      "_comment": "Replace <McpUrl> with the whole McpUrl output, e.g. https://d123abc.cloudfront.net/mcp (do not add another https://). Kiro sends the server URL as the OAuth 'resource', so the scope must be exactly <McpUrl>/read."
    },
    "rst-remote-ecs-token": {
      "url": "<McpUrl>",
      "headers": {
        "Authorization": "Bearer ${RST_MCP_TOKEN}"
      },
      "disabled": true
    },
    "rst-agentcore-gateway": {
      "url": "https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RST_GATEWAY_TOKEN}"
      },
      "disabled": true
    }
  }
}
