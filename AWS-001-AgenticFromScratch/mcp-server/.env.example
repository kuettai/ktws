# Copy to .env and fill in. Never commit .env.

# Transport: stdio (Kiro / Inspector launch the process) or http (container, port 8000)
MCP_TRANSPORT=stdio

# Redshift (Module 02)
# AWS profile from prereqs "Set up your AWS profile"
AWS_PROFILE=workshop
AWS_REGION=us-east-1
REDSHIFT_WORKGROUP=rst-workshop
REDSHIFT_DATABASE=dev

# Operations API (Module 03 Exercise A) - local: docker compose up
OPS_API_BASE_URL=http://localhost:8080
OPS_API_KEY=local-dev-key

# Promotions service (Module 03 Exercise B)
PROMO_API_BASE_URL=http://localhost:8081
PROMO_API_TOKEN=legacy-dev-token

# Simulate a user locally (no auth): hq | manager | staff
LOCAL_ROLE=hq
# LOCAL_BRANCH_ID=12

# Authentication (Module 06) - leave OIDC_ISSUER unset to disable auth
# OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# OIDC_ALLOWED_AUDIENCES=<quick-user client id>,<quick-s2s client id>,<kiro-user client id>
# OIDC_REQUIRED_SCOPES=rst-mcp/read
# MCP_PUBLIC_URL=https://xxxxxxxx.cloudfront.net/mcp
